{
  "name": "ecopulse",
  "version": "1.0.0",
  "description": "Zero-login personal carbon footprint tracker with AI coaching and live local data.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "npm --prefix client install"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "openai": "^4.67.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "vitest": "^3.2.6"
  }
}
